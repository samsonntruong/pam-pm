# Pam example env. Copy to .env and fill in. Never commit real values.
# Keys mirror the secrets template. See docs/setup.md.

# Meta Model API
META_API_KEY=
META_BASE_URL=
META_MODEL=
META_MODEL_DEV=
META_VISION_MODEL=

# GitHub
GITHUB_REPO=
GITHUB_TOKEN=
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=

# Slack
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_TEST_USER_ID=
SLACK_REVIEW_CHANNEL_ID=

# Azure DevOps
ADO_ORG_URL=
ADO_PROJECT=
ADO_TEAM=
ADO_PAT=

# Console auth, needed for any 0.0.0.0 bind including Docker
PAM_CONSOLE_PASSWORD=
