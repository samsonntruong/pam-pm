# Pam example env. Copy to .env and fill in. Never commit real values.
# Keys mirror the secrets template. See docs/setup.md.

# Meta Model API
META_API_KEY=
META_BASE_URL=
META_MODEL=
META_MODEL_DEV=
META_VISION_MODEL=

# GitHub
GITHUB_REPO=
GITHUB_TOKEN=
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=

# Slack
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_TEST_USER_ID=
SLACK_REVIEW_CHANNEL_ID=

# Azure DevOps
ADO_ORG_URL=
ADO_PROJECT=
ADO_TEAM=
ADO_PAT=

# PM connectors. Required vs Optional per connector:
# Trello: TRELLO_BOARD (Required), TRELLO_API_KEY (Required), TRELLO_TOKEN (Required)
# ClickUp: CLICKUP_API_TOKEN (Required), CLICKUP_TEAM (aliases CLICKUP_TEAM_ID, Optional),
#   CLICKUP_LIST (aliases CLICKUP_LIST_ID, Optional; blank means Pam finds or creates one)
# Asana: ASANA_PROJECT (aliases ASANA_PROJECT_ID, Required), ASANA_API_TOKEN (Required)
# Linear: LINEAR_TEAM (aliases LINEAR_TEAM_KEY, Required), LINEAR_API_KEY (Required)
# Jira: JIRA_BASE_URL (aliases JIRA_SITE_URL, Required), JIRA_EMAIL (Required),
#   JIRA_PROJECT (aliases JIRA_PROJECT_KEY, Required), JIRA_API_TOKEN (Required)
# Monday: MONDAY_BOARD (aliases MONDAY_BOARD_ID, Required), MONDAY_API_TOKEN (Required)
TRELLO_BOARD=
TRELLO_API_KEY=
TRELLO_TOKEN=
CLICKUP_TEAM=
CLICKUP_LIST=
CLICKUP_API_TOKEN=
ASANA_PROJECT=
ASANA_API_TOKEN=
LINEAR_TEAM=
LINEAR_API_KEY=
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_PROJECT=
JIRA_API_TOKEN=
MONDAY_BOARD=
MONDAY_API_TOKEN=

# Console auth, needed for any 0.0.0.0 bind including Docker
PAM_CONSOLE_PASSWORD=
